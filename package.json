{
  "name": "hiit-timer",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "preview:phone": "expo start --go --lan",
    "preview:phone:tunnel": "expo start --go --tunnel",
    "preview:dev-client": "expo start --dev-client --lan",
    "update:preview": "eas update --channel preview",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor@latest",
    "test": "node --test \"scripts/*.test.ts\"",
    "stage1:preflight": "node scripts/check-stage1.mjs",
    "test:responsive": "playwright test",
    "export:ios": "expo export --platform ios --output-dir .cache/ios-release-verify --max-workers 2",
    "release:verify": "npm run stage1:preflight && npm run typecheck && npm test && npm run doctor && npm run export:ios && npm run test:responsive"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.24",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.19",
    "expo-speech": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.23",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@playwright/test": "^1.63.0",
    "@types/react": "~19.2.2",
    "react-dom": "^19.2.3",
    "react-native-web": "^0.21.2",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
