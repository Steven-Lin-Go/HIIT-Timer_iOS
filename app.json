{
  "expo": {
    "name": "HIIT Timer",
    "slug": "stevenlin",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/884be3dc-bf2e-4b22-85e0-f81eb5d50520"
    },
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.stevenlin.hiittimer",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stevenlin.hiittimer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/adaptive-foreground.png",
        "backgroundImage": "./assets/android/adaptive-background.png"
      },
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": true
    },
    "extra": {
      "eas": {
        "projectId": "884be3dc-bf2e-4b22-85e0-f81eb5d50520"
      }
    },
    "owner": "stevenlin73s-team",
    "plugins": [
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "HIIT Timer uses the photos you pick to set a custom backdrop for the timer screens."
        }
      ],
      "expo-asset",
      "./plugins/with-android-release"
    ]
  }
}
